# Copie para .env (NUNCA commitar o .env de verdade) ou configure estas variáveis
# como Environment Variables no ambiente do Claude Code / Vercel.

# Token de deploy da Vercel (Project Settings -> Tokens). Tem permissão de
# criar deployments no projeto do relatório de NPS.
VERCEL_TOKEN=

# Opcional: sobrescreve o projectId padrão (ver drive-config.json).
# VERCEL_PROJECT_ID=prj_XElRMaYdx1R5HUkJgto5gqCsjvzS

# Opcional: necessário apenas se o projeto Vercel pertencer a um Team.
# VERCEL_TEAM_ID=
